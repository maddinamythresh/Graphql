type Query{

  employees: [Employee]
  departments: [Department]
}

type Employee{
  id: ID
  name: String
  email: String
  role: String
  salary:Float

}

input UpdateEmployee{
  id:ID
  name: String
  email: String
  role: String
  salary:Float
  department_id: Int
}


type Mutation{
  updateEmployee(input: UpdateEmployee): Employee
  addEmployee(input: UpdateEmployee): Employee
}

type Department{
  department_id: Int
  department_name: String
}

